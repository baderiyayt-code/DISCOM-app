<?xml version='1.0' encoding='utf-8'?>
<widget id="com.discom.surveypro" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>DISCOM Pro</name>
    <description>Enterprise Survey App for DISCOM</description>
    <author email="admin@discom.com" href="http://discom.com">Suraj Singh Mehta</author>
    
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    
    <!-- Custom App Icon and Splash Screen Images -->
    <icon src="res/icon.png" />
    <splash src="res/splash.png" />
    
    <!-- Native Splash Screen Configuration -->
    <preference name="SplashScreen" value="screen" />
    <preference name="SplashScreenDelay" value="10000" /> <!-- JS will hide it when ready -->
    <preference name="AutoHideSplashScreen" value="false" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="FadeSplashScreen" value="true" />
    <preference name="FadeSplashScreenDuration" value="500" />
    <preference name="AndroidXEnabled" value="true" />
    
    <platform name="android">
        <allow-intent href="market:*" />
    </platform>

    <!-- Automatic Plugins Installation -->
    <plugin name="cordova-plugin-splashscreen" spec="^6.0.0" />
    <plugin name="cordova plugin add cordova-plugin-x-socialsharing/>
    <plugin name="​cordova plugin add cordova-plugin-geolocation"/>
</widget>
