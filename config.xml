<?xml version='1.0' encoding='utf-8'?>
<widget id="com.discom.surveypro" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <name>DISCOM Pro</name>
    <description>Enterprise Survey App for DISCOM</description>
    <author email="admin@discom.com" href="http://discom.com">Suraj Singh Mehta</author>
    
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    
    <icon src="res/icon.png" />
    
    <preference name="AndroidXEnabled" value="true" />
    
    <platform name="android">
        <allow-intent href="market:*" />
        
        <!-- Inject tools namespace correctly -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest">
            <manifest xmlns:tools="http://schemas.android.com/tools" />
        </edit-config>
        
        <!-- YEH FIX HAI: parent="/manifest" ensure karega ki merge command sahi jagah apply ho -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="replace" />
        </config-file>
    </platform>

    <!-- Plugins -->
    <plugin name="cordova-plugin-geolocation" />
    <plugin name="cordova-plugin-android-permissions" />
    <plugin name="cordova-plugin-camera" />
    <plugin name="cordova-plugin-x-socialsharing" />
</widget>
